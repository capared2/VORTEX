---
import Base from "../../layouts/Base.astro";
import Rejilla from "../../components/Rejilla.astro";
import Paginacion from "../../components/Paginacion.astro";
import Vacio from "../../components/Vacio.astro";
import Banner from "../../components/Banner.astro";
import BannerNativo from "../../components/BannerNativo.astro";
import { obtenerIndice, obtenerPaginaVertical } from "../../lib/datos";
import { grafoVertical } from "../../lib/seo";
import { SITIO } from "../../lib/sitio";
import { TTL } from "../../lib/cache";
import {
  VERTICALES,
  colorCategoria,
  colorVertical,
  conPagina,
  enlaceCategoria,
  enlaceVertical,
  nombreTema,
  nombreVertical,
  numero,
} from "../../lib/formato";

const { vertical } = Astro.params;

// Solo los cuatro nichos son válidos aquí. Sin esta comprobación, cualquier
// ruta de un segmento entraría en esta página y devolvería un 200 vacío, que
// para un buscador es peor que un 404.
if (!vertical || !(vertical in VERTICALES)) {
  return new Response(null, { status: 404 });
}

const indice = await obtenerIndice();
const temas = (indice?.categories ?? []).filter((c) => c.vertical === vertical);

if (temas.length === 0) {
  return new Response(null, { status: 404 });
}

const POR_PAGINA = 18;
const pagina = Math.max(1, Number(Astro.url.searchParams.get("p") ?? 1) || 1);
const resultado = await obtenerPaginaVertical(temas, pagina, POR_PAGINA);

const nombre = nombreVertical(vertical);
const acento = colorVertical(vertical);
---

<Base
  titulo={conPagina(`${nombre} · ${SITIO.nombre}`, resultado.pagina)}
  tituloSocial={conPagina(nombre, resultado.pagina)}
  descripcion={conPagina(
    `Everything on ${nombre.toLowerCase()}, gathered and sorted by topic on ${SITIO.nombre}.`,
    resultado.pagina,
  )}
  canonical={enlaceVertical(vertical, resultado.pagina)}
  indice={indice}
  verticalActiva={vertical}
  cache={TTL.paginaListado}
  jsonLd={grafoVertical(vertical, resultado.articulos, temas, resultado.pagina)}
  anterior={resultado.pagina > 1 ? enlaceVertical(vertical, resultado.pagina - 1) : null}
  siguiente={resultado.pagina < resultado.paginas ? enlaceVertical(vertical, resultado.pagina + 1) : null}
>
  <!--
    Portadilla de sección, no una caja con un rótulo.

    Antes ponía "SECTION" encima del nombre --que es decir dos veces lo mismo--
    dentro de una banda con degradado, y debajo una fila de pastillas huecas.
    Un periódico hace otra cosa: el nombre grande, un filete del color de la
    sección, el dato al lado en pequeño y los temas como enlaces con su regla.
  -->
  <header class="portadilla mb-6" style={`--acento:${acento}`}>
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h1 class="font-display text-[2.2rem] font-black leading-none tracking-[-0.03em] md:text-[2.6rem]">
        {nombre}
      </h1>
      <p class="text-sm text-[var(--color-tinta-tenue)]">
        <span class="font-semibold text-[var(--color-tinta-suave)]">
          {numero(resultado.total)}
        </span> stories
        <span class="mx-1.5 opacity-40">/</span>
        <span class="font-semibold text-[var(--color-tinta-suave)]">{temas.length}</span> topics
      </p>
    </div>

    <nav
      aria-label={`${nombre} topics`}
      class="mt-4 flex flex-wrap gap-x-5 gap-y-2 max-md:carril max-md:-mx-5 max-md:px-5 max-md:pb-1"
    >
      {
        temas.map((tema) => (
          <a
            href={enlaceCategoria(tema.category)}
            class="enlace-portadilla"
            style={`--acento:${colorCategoria(tema.category)}`}
          >
            {nombreTema(tema.category)}
            <span class="ml-1 text-[0.7rem] opacity-55">{numero(tema.articles)}</span>
          </a>
        ))
      }
    </nav>
  </header>

  <Banner hueco="horizontal" clase="mb-6" />

  {
    resultado.articulos.length === 0 ? (
      <Vacio titulo="No stories in this section yet" />
    ) : (
      <>
        <Rejilla
          articulos={resultado.articulos}
          conApertura={resultado.pagina === 1}
          anuncioCada={6}
        />

        <Banner hueco="franja" clase="mt-8" />
        <Paginacion
          pagina={resultado.pagina}
          paginas={resultado.paginas}
          enlace={(p) => enlaceVertical(vertical, p)}
        />
      </>
    )
  }

  <BannerNativo clase="mt-10" />
  <Banner hueco="horizontal" clase="mt-8" />
</Base>
