---
import Base from "../layouts/Base.astro";
import Tarjeta from "../components/Tarjeta.astro";
import { obtenerIndice, obtenerUltimas, porHistoria } from "../lib/datos";
import { SITIO } from "../lib/sitio";

const [indice, ultimas] = await Promise.all([obtenerIndice(), obtenerUltimas()]);
const sugerencias = porHistoria(ultimas?.articles ?? []).slice(0, 6);

Astro.response.status = 404;
---

<Base
  titulo={`Página no encontrada · ${SITIO.nombre}`}
  descripcion="La página que buscabas no existe."
  canonical="/404"
  indice={indice}
  noindex
>
  <div class="py-10 text-center">
    <p class="font-display text-6xl font-extrabold text-[var(--color-marca)]">404</p>
    <h1 class="mt-3 font-display text-2xl font-extrabold tracking-tight">
      Esta página no existe
    </h1>
    <p class="mx-auto mt-2 max-w-md text-sm text-[var(--color-tinta-suave)]">
      Puede que la dirección esté mal escrita o que la noticia ya no esté en el archivo.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-[var(--color-marca)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[var(--color-marca-oscuro)]"
      >
        Ir a la portada
      </a>
      <a
        href="/temas"
        class="rounded-md border border-[var(--color-linea)] px-4 py-2 text-sm font-semibold transition hover:border-[var(--color-marca)]"
      >
        Ver los temas
      </a>
    </div>
  </div>

  {
    sugerencias.length > 0 && (
      <section class="mt-10 border-t border-[var(--color-linea)] pt-6">
        <h2 class="mb-4 font-display text-lg font-extrabold tracking-tight">Mientras tanto</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {sugerencias.map((articulo) => <Tarjeta articulo={articulo} />)}
        </div>
      </section>
    )
  }
</Base>
