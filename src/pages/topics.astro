---
import Base from "../layouts/Base.astro";
import { obtenerIndice } from "../lib/datos";
import { grafoTemas } from "../lib/seo";
import { SITIO } from "../lib/sitio";
import { TTL } from "../lib/cache";
import Banner from "../components/Banner.astro";
import BannerNativo from "../components/BannerNativo.astro";
import {
  colorCategoria,
  colorVertical,
  enlaceCategoria,
  enlaceVertical,
  nombreTema,
  nombreVertical,
  numero,
} from "../lib/formato";

const indice = await obtenerIndice();
const verticales = indice?.verticals ?? [];
---

<Base
  titulo={`All topics · ${SITIO.nombre}`}
  descripcion={`The ${indice?.total_categories ?? 0} topics ${SITIO.nombre} is organised into, across every section.`}
  canonical="/topics"
  indice={indice}
  cache={TTL.paginaListado}
  jsonLd={grafoTemas(indice)}
>
  <header class="mb-7 border-b border-[var(--color-linea)] pb-3">
    <h1 class="font-display text-3xl font-extrabold tracking-tight">All topics</h1>
    {
      indice && (
        <p class="mt-1 text-sm text-[var(--color-tinta-tenue)]">
          {numero(indice.total_articles)} stories across {numero(indice.total_categories)} topics
        </p>
      )
    }
  </header>

  <Banner hueco="horizontal" clase="mb-6" />

  <div class="space-y-9">
    {
      verticales.map((vertical) => {
        const temas = (indice?.categories ?? []).filter((c) => c.vertical === vertical.vertical);
        const acento = colorVertical(vertical.vertical);
        return (
          <section>
            <h2 class="banda-tema mb-3 py-2.5" style={`--acento:${acento}`}>
              <a
                href={enlaceVertical(vertical.vertical)}
                class="font-display text-xl font-extrabold tracking-tight hover:brightness-110"
                style={`color:${acento}`}
              >
                {nombreVertical(vertical.vertical)}
              </a>
              <span class="ml-2 text-xs font-normal text-[var(--color-tinta-tenue)]">
                {numero(vertical.articles)} stories
              </span>
            </h2>
            <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
              {temas.map((tema) => (
                <li>
                  <a
                    href={enlaceCategoria(tema.category)}
                    class="ficha-tema flex items-baseline justify-between gap-3 px-3.5 py-2.5 transition hover:-translate-y-0.5"
                    style={`--acento:${colorCategoria(tema.category)}`}
                  >
                    <span
                      class="font-semibold"
                      style={`color:${colorCategoria(tema.category)}`}
                    >
                      {nombreTema(tema.category)}
                    </span>
                    <span class="shrink-0 text-xs text-[var(--color-tinta-tenue)]">
                      {numero(tema.articles)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>

  <BannerNativo clase="mt-10" />
  <Banner hueco="franja" clase="mt-8" />
</Base>
