---
import Base from "../../layouts/Base.astro";
import Tarjeta from "../../components/Tarjeta.astro";
import { contextoDe, TTL } from "../../lib/cache";
import { obtenerContexto, obtenerIndice, obtenerNoticia } from "../../lib/datos";
import { grafoNoticia } from "../../lib/seo";
import { MOSTRAR_CUERPO_COMPLETO, PARRAFOS_DE_MUESTRA, SITIO } from "../../lib/sitio";
import {
  colorCategoria,
  enlaceCategoria,
  enlaceVertical,
  fecha,
  nombreTema,
  nombreVertical,
  numero,
  recortar,
  rutaImagen,
} from "../../lib/formato";

// La ruta es /article/<vertical>/<tema>/<id>: la categoría son todos los
// segmentos menos el último.
const partes = (Astro.params.ruta ?? "").split("/").filter(Boolean);
if (partes.length < 3) {
  return new Response(null, { status: 404 });
}

const id = partes[partes.length - 1]!;
const categoria = partes.slice(0, -1).join("/");

const noticia = await obtenerNoticia(categoria, id, contextoDe(Astro.locals));
if (!noticia) {
  return new Response(null, { status: 404 });
}

const [indice, contexto] = await Promise.all([obtenerIndice(), obtenerContexto(noticia)]);
const { versiones, relacionadas } = contexto;

const vertical = noticia.vertical || categoria.split("/")[0]!;
const acento = colorCategoria(noticia.category);
const imagen = rutaImagen(noticia.images?.[0]?.url);
const pie = noticia.images?.[0]?.caption;

const parrafos = MOSTRAR_CUERPO_COMPLETO
  ? noticia.paragraphs
  : noticia.paragraphs.slice(0, PARRAFOS_DE_MUESTRA);
const recortada = parrafos.length < noticia.paragraphs.length;

const entradilla = noticia.standfirst || noticia.summary;
const descripcion = recortar(noticia.summary || noticia.standfirst || noticia.body, 180);
---

<Base
  titulo={`${recortar(noticia.title, 65)} · ${SITIO.nombre}`}
  descripcion={descripcion}
  canonical={`/article/${noticia.category}/${noticia.id}`}
  indice={indice}
  verticalActiva={vertical}
  idioma={noticia.language || SITIO.idioma}
  cache={TTL.paginaNoticia}
  imagen={imagen}
  tipo="article"
  publicado={noticia.published_at}
  modificado={noticia.modified_at}
  seccion={nombreTema(noticia.category)}
  etiquetas={noticia.tags}
  jsonLd={grafoNoticia(noticia, imagen)}
>
  <div class="grid gap-9 lg:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]">
    <article>
      <nav aria-label="Breadcrumb" class="mb-3 text-xs text-[var(--color-tinta-tenue)]">
        <a href="/" class="hover:text-[var(--color-marca)]">Home</a>
        <span class="mx-1.5">›</span>
        <a href={enlaceVertical(vertical)} class="hover:text-[var(--color-marca)]">
          {nombreVertical(vertical)}
        </a>
        <span class="mx-1.5">›</span>
        <a href={enlaceCategoria(noticia.category)} class="hover:text-[var(--color-marca)]">
          {nombreTema(noticia.category)}
        </a>
      </nav>

      <header>
        <a
          href={enlaceCategoria(noticia.category)}
          class="text-xs font-bold uppercase tracking-wider hover:underline"
          style={`color:${acento}`}
        >
          {noticia.topic_name || nombreTema(noticia.category)}
        </a>

        <h1 class="mt-2 font-display text-3xl font-extrabold leading-[1.12] tracking-tight sm:text-[2.6rem]">
          {noticia.title}
        </h1>

        {
          entradilla && (
            <p class="standfirst mt-3 font-serif text-lg leading-relaxed text-[var(--color-tinta-suave)]">
              {entradilla}
            </p>
          )
        }

        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 border-y border-[var(--color-linea)] py-2.5 text-xs text-[var(--color-tinta-tenue)]">
          {
            noticia.published_at && (
              <time datetime={noticia.published_at}>{fecha(noticia.published_at, true)}</time>
            )
          }
          {noticia.word_count > 0 && <span>· {numero(noticia.word_count)} words</span>}
          {
            versiones.length > 0 && (
              <span>
                · <a href="#versiones" class="underline hover:text-[var(--color-marca)]">
                  {versiones.length + 1} takes on this story
                </a>
              </span>
            )
          }
          {
            noticia.modified_at && noticia.modified_at !== noticia.published_at && (
              <span>· updated {fecha(noticia.modified_at, true)}</span>
            )
          }
        </div>
      </header>

      {
        imagen && (
          <figure class="mt-5">
            <img
              src={imagen}
              alt={pie || ""}
              width="1200"
              height="675"
              fetchpriority="high"
              decoding="async"
              class="w-full rounded-xl bg-[var(--color-lienzo-alt)] object-cover"
            />
            {pie && (
              <figcaption class="mt-2 text-xs text-[var(--color-tinta-tenue)]">{pie}</figcaption>
            )}
          </figure>
        )
      }

      <div class="prosa mt-6 max-w-[68ch]">
        {parrafos.map((parrafo) => <p>{parrafo}</p>)}
      </div>

      {
        recortada && (
          <p class="mt-4 max-w-[68ch] rounded-lg border border-[var(--color-linea)] bg-[var(--color-lienzo)] px-4 py-3 text-sm text-[var(--color-tinta-suave)]">
            Only an extract of this story is shown.
          </p>
        )
      }

      {
        noticia.tags.length > 0 && (
          <div class="mt-7 border-t border-[var(--color-linea)] pt-4">
            <h2 class="mb-2 font-display text-xs font-bold uppercase tracking-wider text-[var(--color-tinta-tenue)]">
              Topics in this story
            </h2>
            <ul class="flex flex-wrap gap-2">
              {noticia.tags.slice(0, 12).map((etiqueta) => (
                <li>
                  <a
                    href={`/search?q=${encodeURIComponent(etiqueta)}`}
                    class="inline-block rounded-full bg-[var(--color-lienzo-alt)] px-3 py-1 text-xs text-[var(--color-tinta-suave)] transition hover:text-[var(--color-marca)]"
                  >
                    {etiqueta}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-6 text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
        Gathered from external sources. Rights to this text belong to whoever
        originally published it.
      </p>
    </article>

    <aside class="space-y-8 lg:border-l lg:border-[var(--color-linea)] lg:pl-6">
      {
        versiones.length > 0 && (
          <section id="versiones">
            <h2 class="mb-1 font-display text-xs font-bold uppercase tracking-wider" style={`color:${acento}`}>
              Other takes on this story
            </h2>
            <p class="mb-3 text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
              The same story told elsewhere, with its own angle.
            </p>
            <div class="space-y-3">
              {versiones.map((articulo) => (
                <Tarjeta articulo={articulo} variante="compacta" />
              ))}
            </div>
          </section>
        )
      }

      {
        relacionadas.length > 0 && (
          <section>
            <h2 class="mb-3 font-display text-xs font-bold uppercase tracking-wider text-[var(--color-tinta-tenue)]">
              Related
            </h2>
            <div class="space-y-3">
              {relacionadas.map((articulo) => (
                <Tarjeta articulo={articulo} variante="compacta" />
              ))}
            </div>
          </section>
        )
      }
    </aside>
  </div>
</Base>
