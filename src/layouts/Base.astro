---
import "../styles/global.css";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import Seo from "../components/Seo.astro";
import Anuncios from "../components/Anuncios.astro";
import Analitica from "../components/Analitica.astro";
import BarraApp from "../components/BarraApp.astro";
import Menu from "../components/Menu.astro";
import type { Indice } from "../lib/types";
import { SITIO } from "../lib/sitio";

const FUENTES =
  "https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900" +
  "&family=Inter:wght@400;500;600;700" +
  "&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap";

interface Props {
  titulo: string;
  /** Titular sin el sufijo del sitio, para las tarjetas al compartir. */
  tituloSocial?: string;
  descripcion?: string;
  /** Ruta canónica de esta página. */
  canonical: string;
  indice: Indice | null;
  /** Segundos que el edge de Cloudflare puede reutilizar la respuesta. */
  cache?: number;
  /**
   * Idioma de esta página. El archivo reúne noticias en varios idiomas, y
   * declararlas todas como españolas confunde a los buscadores y hace que un
   * lector de pantalla las lea con la fonética equivocada.
   */
  idioma?: string;
  verticalActiva?: string;
  /** En móvil, adónde vuelve la flecha de la cabecera si se llegó de fuera. */
  atras?: string;
  imagen?: string | null;
  imagenAlt?: string | null;
  tipo?: "website" | "article";
  publicado?: string | null;
  modificado?: string | null;
  seccion?: string;
  etiquetas?: string[];
  noindex?: boolean;
  jsonLd?: object[];
  anterior?: string | null;
  siguiente?: string | null;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  canonical,
  indice,
  cache = 900,
  idioma = SITIO.idioma,
  verticalActiva,
  atras,
  ...seo
} = Astro.props;

/**
 * Precarga de la siguiente página al tocar un enlace, antes de levantar el
 * dedo: en un teléfono son las décimas que separan una web de una aplicación.
 * Solo se descarga el HTML --no se ejecuta nada--, así que ni cuenta visitas
 * ni pide anuncios. Las imágenes y los ficheros sueltos se quedan fuera.
 */
const PRECARGA = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/img/*" } },
          { not: { href_matches: "/*.xml" } },
          { not: { href_matches: "/*.txt" } },
        ],
      },
      eagerness: "conservative",
    },
  ],
});

// El service worker solo sirve la página sin conexión. En desarrollo estorba
// más que ayuda: se quedaría con la versión vieja de las páginas.
const conServiceWorker = import.meta.env.PROD;

// El dataset se regenera cada dos horas: servir desde el edge y revalidar en
// segundo plano mantiene el sitio rápido sin quedarse obsoleto.
Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=60, s-maxage=${cache}, stale-while-revalidate=86400`,
);
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <!-- `viewport-fit=cover` deja pintar bajo la muesca; los márgenes seguros
         se reservan en las barras de arriba y de abajo. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo titulo={titulo} descripcion={descripcion} canonical={canonical} idioma={idioma} {...seo} />

    <Analitica />

    <link rel="dns-prefetch" href="https://www.highrevenueformat.com" />
    <link rel="dns-prefetch" href="https://pl31044382.profitableratecpmnetwork.com" />
    <link rel="dns-prefetch" href="https://pl31044383.profitableratecpmnetwork.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Las tipografías se cargan sin bloquear el pintado. Una hoja de estilo de
      otro dominio detiene el primer render hasta que llega, y ese retraso es
      justo lo que mide el LCP, que sí cuenta para posicionar. Con
      `media="print"` el navegador la baja con prioridad baja y no espera a
      ella; al terminar se pasa a `all` y las fuentes entran. El `noscript` es
      para el rastreador que no ejecuta guiones.
    -->
    <link
      href={FUENTES}
      rel="stylesheet"
      media="print"
      onload="this.media='all';this.onload=null"
    />
    <noscript><link href={FUENTES} rel="stylesheet" /></noscript>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Instalable como aplicación: con el manifiesto, Android ofrece añadirla a
      la pantalla de inicio y se abre en su propia ventana, sin la barra del
      navegador. iOS no lee el manifiesto para todo y pide sus propias
      etiquetas, y un icono PNG: el SVG lo ignora y hace una captura de la web.
    -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Gigantum" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <!-- Del color de la cabecera y no de la marca, para que la barra del
         navegador y la del sitio se lean como una sola. El guion de abajo la
         cambia si el tema es oscuro. -->
    <meta name="theme-color" content="#ffffff" />
    <script is:inline type="speculationrules" set:html={PRECARGA} />

    <script is:inline>
      // Si una foto no llega, se quita del flujo en vez de enseñar el icono
      // de imagen rota. Pasan por el proxy del propio sitio, pero el original
      // puede haber desaparecido. Se oculta con `display` y no con
      // `visibility` porque, si no, la foto de apertura de una noticia deja un
      // hueco en blanco de más de quinientos píxeles antes del texto; y se
      // oculta el `<figure>` entero para no dejar el pie huérfano.
      addEventListener(
        "error",
        (evento) => {
          const elemento = evento.target;
          if (!(elemento instanceof HTMLImageElement)) return;
          // Se retira el contenedor entero --el `<figure>` de la noticia o el
          // hueco de la foto en una tarjeta--, no solo la imagen: si no, la
          // apertura se queda con media tarjeta en blanco.
          const contenedor = elemento.closest("figure, [data-foto]") ?? elemento;
          contenedor.style.display = "none";
        },
        true,
      );

      // El tema se aplica antes de pintar para que no haya destello.
      try {
        const guardado = localStorage.getItem("tema");
        const oscuro = guardado
          ? guardado === "oscuro"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("oscuro", oscuro);
        if (oscuro) {
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#12141a");
        }
      } catch {
        // Almacenamiento bloqueado: se queda con el tema del sistema.
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-[var(--color-marca)] focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Cabecera indice={indice} verticalActiva={verticalActiva} atras={atras} />

    <main id="contenido" class="contenedor w-full flex-1 py-5 md:py-7">
      <slot />
    </main>

    <Pie indice={indice} />

    <BarraApp verticalActiva={verticalActiva} inicio={canonical === "/"} />
    <Menu indice={indice} />

    <Anuncios />

    {
      conServiceWorker && (
        <script is:inline>
          if ("serviceWorker" in navigator) {
            addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
          }
        </script>
      )
    }
  </body>
</html>
