---
import type { Indice } from "../lib/types";
import Logo from "./Logo.astro";
import { SITIO } from "../lib/sitio";
import {
  colorCategoria,
  colorVertical,
  enlaceCategoria,
  enlaceVertical,
  nombreTema,
  nombreVertical,
  numero,
} from "../lib/formato";

interface Props {
  indice: Indice | null;
}

const { indice } = Astro.props;
const verticales = indice?.verticals ?? [];
const año = new Date().getFullYear();
---

<footer class="mt-10 border-t border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <div class="contenedor grid gap-8 py-10 md:grid-cols-[1.4fr_2fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <Logo id="pie" />
        <span class="font-display text-lg font-extrabold tracking-tight">{SITIO.nombre}</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--color-tinta-suave)]">
        {SITIO.descripcion}
      </p>
      {
        indice && (
          <p class="mt-3 text-xs text-[var(--color-tinta-tenue)]">
            {numero(indice.total_articles)} stories across {numero(indice.total_categories)} topics.
          </p>
        )
      }
    </div>

    <nav aria-label="Sections" class="grid grid-cols-2 gap-6 sm:grid-cols-4">
      {
        verticales.map((vertical) => (
          <div>
            <h2 class="font-display text-xs font-bold uppercase tracking-wider">
              <a
                href={enlaceVertical(vertical.vertical)}
                class="hover:brightness-110"
                style={`color:${colorVertical(vertical.vertical)}`}
              >
                {nombreVertical(vertical.vertical)}
              </a>
            </h2>
            <ul class="mt-2 space-y-1.5">
              {(indice?.categories ?? [])
                .filter((c) => c.vertical === vertical.vertical)
                .slice(0, 6)
                .map((c) => (
                  <li>
                    <a
                      href={enlaceCategoria(c.category)}
                      class="enlace-tema text-sm text-[var(--color-tinta-suave)]"
                      style={`--acento:${colorCategoria(c.category)}`}
                    >
                      {nombreTema(c.category)}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-[var(--color-linea)]">
    <div class="contenedor flex flex-col gap-3 py-5 text-xs text-[var(--color-tinta-tenue)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {año} {SITIO.nombre}</p>
      <nav aria-label="Footer links" class="flex flex-wrap gap-4">
        <a href="/topics" class="hover:text-[var(--color-marca)]">Topics</a>
        <a href="/search" class="hover:text-[var(--color-marca)]">Search</a>
        <a href="/rss.xml" class="hover:text-[var(--color-marca)]">RSS</a>
        <a href="/sitemap.xml" class="hover:text-[var(--color-marca)]">Sitemap</a>
      </nav>
    </div>
    <p class="contenedor pb-6 text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
      Content gathered automatically from external sources and reorganised by topic.
      Rights to each text belong to whoever originally published it.
    </p>
  </div>
</footer>
