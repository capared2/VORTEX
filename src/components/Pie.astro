---
import type { Indice } from "../lib/types";
import Logo from "./Logo.astro";
import { SITIO } from "../lib/sitio";
import { enlaceCategoria, enlaceVertical, nombreTema, nombreVertical, numero } from "../lib/formato";

interface Props {
  indice: Indice | null;
}

const { indice } = Astro.props;
const verticales = indice?.verticals ?? [];
const año = new Date().getFullYear();
---

<footer class="mt-10 border-t border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <div class="contenedor grid gap-8 py-10 md:grid-cols-[1.4fr_2fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <Logo />
        <span class="font-display text-lg font-extrabold tracking-tight">{SITIO.nombre}</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--color-tinta-suave)]">
        {SITIO.descripcion}
      </p>
      {
        indice && (
          <p class="mt-3 text-xs text-[var(--color-tinta-tenue)]">
            {numero(indice.total_articles)} noticias en {numero(indice.total_categories)} temas.
          </p>
        )
      }
    </div>

    <nav aria-label="Secciones" class="grid grid-cols-2 gap-6 sm:grid-cols-4">
      {
        verticales.map((vertical) => (
          <div>
            <h2 class="font-display text-xs font-bold uppercase tracking-wider text-[var(--color-tinta)]">
              <a href={enlaceVertical(vertical.vertical)} class="hover:text-[var(--color-marca)]">
                {nombreVertical(vertical.vertical)}
              </a>
            </h2>
            <ul class="mt-2 space-y-1.5">
              {(indice?.categories ?? [])
                .filter((c) => c.vertical === vertical.vertical)
                .slice(0, 6)
                .map((c) => (
                  <li>
                    <a
                      href={enlaceCategoria(c.category)}
                      class="text-sm text-[var(--color-tinta-suave)] hover:text-[var(--color-marca)]"
                    >
                      {nombreTema(c.category)}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-[var(--color-linea)]">
    <div class="contenedor flex flex-col gap-3 py-5 text-xs text-[var(--color-tinta-tenue)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {año} {SITIO.nombre}</p>
      <nav aria-label="Enlaces del pie" class="flex flex-wrap gap-4">
        <a href="/temas" class="hover:text-[var(--color-marca)]">Temas</a>
        <a href="/buscar" class="hover:text-[var(--color-marca)]">Buscar</a>
        <a href="/rss.xml" class="hover:text-[var(--color-marca)]">RSS</a>
        <a href="/sitemap.xml" class="hover:text-[var(--color-marca)]">Mapa del sitio</a>
      </nav>
    </div>
    <p class="contenedor pb-6 text-xs leading-relaxed text-[var(--color-tinta-tenue)]">
      Contenido recopilado automáticamente de fuentes externas y reorganizado por temas.
      Los derechos de cada texto pertenecen a quien lo publicó originalmente.
    </p>
  </div>
</footer>
