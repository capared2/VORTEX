---
import type { Historia, Noticia, Tarjeta } from "../lib/types";
import {
  colorCategoria,
  enlaceCategoria,
  enlaceNoticia,
  haceCuanto,
  nombreTema,
  rutaImagen,
} from "../lib/formato";

type Variante = "apertura" | "normal" | "compacta" | "titular";

interface Props {
  articulo: Tarjeta | Noticia | Historia;
  variante?: Variante;
  /** Prioridad de carga: solo para lo que se ve sin desplazarse. */
  prioritaria?: boolean;
}

const { articulo, variante = "normal", prioritaria = false } = Astro.props;

const imagen = rutaImagen(
  "image" in articulo ? articulo.image : (articulo as Noticia).images?.[0]?.url,
);
const entradilla = articulo.standfirst || articulo.summary;
const enlace = enlaceNoticia(articulo.category, articulo.id);
// El nombre lo pone el sitio a partir de la clave, no el dataset: así un
// registro guardado antes de un cambio de nombres no se cuela con el viejo.
const tema = nombreTema(articulo.category);

// Cuántos medios cuentan esta misma historia. Se dice el número, nunca quiénes.
const coberturas = "coverage" in articulo ? articulo.coverage : 1;
const carga = prioritaria ? "eager" : "lazy";
const acento = colorCategoria(articulo.category);
// En el móvil las tarjetas corrientes se pintan como las filas de una app de
// noticias: titular a la izquierda y la foto pequeña a la derecha. Así caben
// cuatro o cinco por pantalla en vez de una y media. La apertura no cambia:
// es la noticia grande de arriba.
const fila = variante === "normal";
---

{
  variante === "titular" ? (
    <article class="filo-lado py-2.5 pl-3.5" style={`--acento:${acento}`}>
      <a href={enlaceCategoria(articulo.category)} class="chip-tema">
        {tema}
      </a>
      <h3 class="lineas-3 mt-1 font-display text-[0.95rem] font-bold leading-snug">
        <a href={enlace} class="enlace-tema">
          {articulo.title}
        </a>
      </h3>
      <div class="mt-1 flex items-center gap-2 text-[0.7rem] text-[var(--color-tinta-tenue)]">
        {articulo.published_at && (
          <time datetime={articulo.published_at}>{haceCuanto(articulo.published_at)}</time>
        )}
        {coberturas > 1 && <span class="marca-tema">{coberturas} takes</span>}
      </div>
    </article>
  ) : variante === "compacta" ? (
    <article
      class="group flex gap-3 border-b border-[var(--color-linea)] pb-3 last:border-0"
      style={`--acento:${acento}`}
    >
      {imagen && (
        <a
          href={enlace}
          class="shrink-0 overflow-hidden rounded-lg bg-[var(--color-lienzo-alt)]"
          data-foto
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={imagen}
            alt=""
            loading="lazy"
            decoding="async"
            width="80"
            height="80"
            class="size-20 object-cover transition duration-300 group-hover:scale-105"
          />
        </a>
      )}
      <div class="min-w-0">
        <a href={enlaceCategoria(articulo.category)} class="chip-tema">
          {tema}
        </a>
        <h3 class="lineas-3 mt-1 font-display text-[0.95rem] font-bold leading-snug">
          <a href={enlace} class="enlace-tema">
            {articulo.title}
          </a>
        </h3>
        <div class="mt-0.5 flex items-center gap-2 text-[0.7rem] text-[var(--color-tinta-tenue)]">
          {articulo.published_at && (
            <time datetime={articulo.published_at}>{haceCuanto(articulo.published_at)}</time>
          )}
          {coberturas > 1 && <span class="marca-tema">{coberturas} takes</span>}
        </div>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        "tarjeta-tema group flex flex-col overflow-hidden transition hover:-translate-y-0.5",
        variante === "apertura" && "md:flex-row",
        fila && "max-sm:flex-row-reverse max-sm:items-start",
      ]}
      style={`--acento:${acento}`}
    >
      {imagen && (
        <a
          href={enlace}
          class:list={[
            "block shrink-0 overflow-hidden bg-[var(--color-lienzo-alt)]",
            variante === "apertura" && "md:w-1/2",
            fila && "max-sm:m-3 max-sm:ml-0 max-sm:w-[5.75rem] max-sm:rounded-lg",
          ]}
          data-foto
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={imagen}
            alt=""
            loading={carga}
            fetchpriority={prioritaria ? "high" : undefined}
            decoding="async"
            class:list={[
              "w-full object-cover transition duration-500 group-hover:scale-[1.03]",
              variante === "apertura" ? "aspect-[16/10] md:h-full" : "aspect-[16/9] max-sm:aspect-square",
            ]}
          />
        </a>
      )}

      <div class:list={["flex min-w-0 flex-1 flex-col p-4", fila && "max-sm:p-3"]}>
        <div class="flex items-center gap-2">
          <a href={enlaceCategoria(articulo.category)} class="chip-tema">
            {tema}
          </a>
          {coberturas > 1 && (
            <span
              class="marca-tema"
              title="How many separate takes on this same story are collected"
            >
              {coberturas} takes
            </span>
          )}
        </div>

        <h3
          class:list={[
            "mt-1.5 font-display font-bold leading-tight",
            variante === "apertura" ? "lineas-4 text-2xl md:text-3xl" : "lineas-3 text-lg max-sm:text-[1rem]",
          ]}
        >
          <a href={enlace} class="enlace-tema">
            {articulo.title}
          </a>
        </h3>

        {entradilla && (
          <p
            class:list={[
              "mt-2 text-sm leading-relaxed text-[var(--color-tinta-suave)]",
              variante === "apertura" ? "lineas-4" : "lineas-2",
              fila && "max-sm:hidden",
            ]}
          >
            {entradilla}
          </p>
        )}

        {articulo.published_at && (
          <time
            datetime={articulo.published_at}
            class:list={["mt-auto pt-3 text-xs text-[var(--color-tinta-tenue)]", fila && "max-sm:pt-1.5"]}
          >
            {haceCuanto(articulo.published_at)}
          </time>
        )}
      </div>
    </article>
  )
}
