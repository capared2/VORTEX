---
import type { Historia, Noticia, Tarjeta } from "../lib/types";
import {
  colorCategoria,
  enlaceCategoria,
  enlaceNoticia,
  haceCuanto,
  nombreTema,
  rutaImagen,
} from "../lib/formato";

type Variante = "apertura" | "normal" | "compacta" | "titular";

interface Props {
  articulo: Tarjeta | Noticia | Historia;
  variante?: Variante;
  /** Prioridad de carga: solo para lo que se ve sin desplazarse. */
  prioritaria?: boolean;
}

const { articulo, variante = "normal", prioritaria = false } = Astro.props;

const imagen = rutaImagen(
  "image" in articulo ? articulo.image : (articulo as Noticia).images?.[0]?.url,
);
const entradilla = articulo.standfirst || articulo.summary;
const enlace = enlaceNoticia(articulo.category, articulo.id);
const acento = colorCategoria(articulo.category);
// El nombre lo pone el sitio a partir de la clave, no el dataset: así un
// registro guardado antes de un cambio de nombres no se cuela con el viejo.
const tema = nombreTema(articulo.category);

// Cuántos medios cuentan esta misma historia. Se dice el número, nunca quiénes.
const coberturas = "coverage" in articulo ? articulo.coverage : 1;
const carga = prioritaria ? "eager" : "lazy";
---

{
  variante === "titular" ? (
    <article class="barra-nicho py-2.5 pl-3.5" style={`--acento:${acento}`}>
      <a
        href={enlaceCategoria(articulo.category)}
        class="text-[0.62rem] font-bold uppercase tracking-wider hover:underline"
        style={`color:${acento}`}
      >
        {tema}
      </a>
      <h3 class="lineas-3 mt-0.5 font-display text-[0.95rem] font-bold leading-snug">
        <a href={enlace} class="hover:text-[var(--color-marca)]">
          {articulo.title}
        </a>
      </h3>
      <div class="mt-1 flex items-center gap-2 text-[0.7rem] text-[var(--color-tinta-tenue)]">
        {articulo.published_at && (
          <time datetime={articulo.published_at}>{haceCuanto(articulo.published_at)}</time>
        )}
        {coberturas > 1 && <span>· {coberturas} takes</span>}
      </div>
    </article>
  ) : variante === "compacta" ? (
    <article class="group flex gap-3 border-b border-[var(--color-linea)] pb-3 last:border-0">
      <a
        href={enlace}
        class="shrink-0 overflow-hidden rounded-lg bg-[var(--color-lienzo-alt)]"
        data-foto
        tabindex="-1"
        aria-hidden="true"
      >
        {imagen ? (
          <img
            src={imagen}
            alt=""
            loading="lazy"
            decoding="async"
            width="80"
            height="80"
            class="size-20 object-cover transition duration-300 group-hover:scale-105"
          />
        ) : (
          <div class="size-20" />
        )}
      </a>
      <div class="min-w-0">
        <a
          href={enlaceCategoria(articulo.category)}
          class="text-[0.62rem] font-bold uppercase tracking-wider hover:underline"
          style={`color:${acento}`}
        >
          {tema}
        </a>
        <h3 class="lineas-3 font-display text-[0.95rem] font-bold leading-snug">
          <a href={enlace} class="hover:text-[var(--color-marca)]">
            {articulo.title}
          </a>
        </h3>
        <div class="mt-0.5 flex items-center gap-2 text-[0.7rem] text-[var(--color-tinta-tenue)]">
          {articulo.published_at && (
            <time datetime={articulo.published_at}>{haceCuanto(articulo.published_at)}</time>
          )}
          {coberturas > 1 && <span>· {coberturas} takes</span>}
        </div>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        "group flex flex-col overflow-hidden rounded-xl border border-[var(--color-linea)] bg-[var(--color-lienzo)] shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg",
        variante === "apertura" && "md:flex-row",
      ]}
    >
      <a
        href={enlace}
        class:list={[
          "block shrink-0 overflow-hidden bg-[var(--color-lienzo-alt)]",
          variante === "apertura" && "md:w-1/2",
        ]}
        data-foto
        tabindex="-1"
        aria-hidden="true"
      >
        {imagen ? (
          <img
            src={imagen}
            alt=""
            loading={carga}
            fetchpriority={prioritaria ? "high" : undefined}
            decoding="async"
            class:list={[
              "w-full object-cover transition duration-500 group-hover:scale-[1.03]",
              variante === "apertura" ? "aspect-[16/10] md:h-full" : "aspect-[16/9]",
            ]}
          />
        ) : (
          <div class:list={[variante === "apertura" ? "aspect-[16/10]" : "aspect-[16/9]"]} />
        )}
      </a>

      <div class="flex flex-1 flex-col p-4">
        <div class="flex items-center gap-2">
          <a
            href={enlaceCategoria(articulo.category)}
            class="text-[0.65rem] font-bold uppercase tracking-wider hover:underline"
            style={`color:${acento}`}
          >
            {tema}
          </a>
          {coberturas > 1 && (
            <span
              class="rounded-full px-1.5 py-px text-[0.6rem] font-bold uppercase tracking-wide text-white"
              style={`background:${acento}`}
              title="How many separate takes on this same story are collected"
            >
              {coberturas} takes
            </span>
          )}
        </div>

        <h3
          class:list={[
            "mt-1.5 font-display font-bold leading-tight",
            variante === "apertura" ? "lineas-4 text-2xl md:text-3xl" : "lineas-3 text-lg",
          ]}
        >
          <a href={enlace} class="hover:text-[var(--color-marca)]">
            {articulo.title}
          </a>
        </h3>

        {entradilla && (
          <p
            class:list={[
              "mt-2 text-sm leading-relaxed text-[var(--color-tinta-suave)]",
              variante === "apertura" ? "lineas-4" : "lineas-2",
            ]}
          >
            {entradilla}
          </p>
        )}

        {articulo.published_at && (
          <time
            datetime={articulo.published_at}
            class="mt-auto pt-3 text-xs text-[var(--color-tinta-tenue)]"
          >
            {haceCuanto(articulo.published_at)}
          </time>
        )}
      </div>
    </article>
  )
}
