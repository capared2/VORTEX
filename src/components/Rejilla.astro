---
import type { Historia, Noticia, Tarjeta } from "../lib/types";
import TarjetaArticulo from "./Tarjeta.astro";

interface Props {
  articulos: (Tarjeta | Noticia | Historia)[];
  /** La primera se pinta a lo grande, como apertura. */
  conApertura?: boolean;
  columnas?: 2 | 3;
}

const { articulos, conApertura = false, columnas = 3 } = Astro.props;

const apertura = conApertura ? articulos[0] : undefined;
const resto = conApertura ? articulos.slice(1) : articulos;
---

{apertura && <div class="mb-5"><TarjetaArticulo articulo={apertura} variante="apertura" prioritaria /></div>}

<div
  class:list={[
    "grid gap-5 sm:grid-cols-2",
    columnas === 3 ? "lg:grid-cols-3" : "lg:grid-cols-2",
  ]}
>
  {resto.map((articulo, indice) => (
    <TarjetaArticulo articulo={articulo} prioritaria={!conApertura && indice < 3} />
  ))}
</div>
