---
import type { Indice } from "../lib/types";
import Logo from "./Logo.astro";
import { SITIO } from "../lib/sitio";
import { colorVertical, enlaceVertical, fechaLarga, nombreVertical } from "../lib/formato";

interface Props {
  indice: Indice | null;
  verticalActiva?: string;
}

const { indice, verticalActiva } = Astro.props;

// El orden lo marca el propio archivo: el nicho con más fondo va primero.
const verticales = (indice?.verticals ?? []).map((v) => v.vertical);
// Si el índice no llega, la navegación no puede desaparecer.
const nichos = verticales.length ? verticales : ["noticias", "deportes", "gamer", "tecnologia"];
const hoy = fechaLarga(new Date());
---

<header class="sticky top-0 z-40 border-b border-[var(--color-linea)] bg-[var(--color-lienzo)]/95 backdrop-blur">
  <div class="contenedor flex h-14 items-center gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${SITIO.nombre}, ir a la portada`}>
      <Logo />
      <span class="font-display text-xl font-extrabold tracking-tight">{SITIO.nombre}</span>
    </a>

    <nav aria-label="Nichos" class="hidden min-w-0 flex-1 md:block">
      <ul class="flex items-center gap-1">
        {
          nichos.map((clave) => (
            <li>
              <a
                href={enlaceVertical(clave)}
                aria-current={verticalActiva === clave ? "page" : undefined}
                class:list={[
                  "block rounded-md px-3 py-1.5 font-display text-sm font-bold uppercase tracking-wide transition",
                  verticalActiva === clave
                    ? "text-white"
                    : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)] hover:text-[var(--color-tinta)]",
                ]}
                style={verticalActiva === clave ? `background:${colorVertical(clave)}` : undefined}
              >
                {nombreVertical(clave)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <form action="/buscar" method="get" role="search" class="hidden sm:block">
        <label for="q" class="sr-only">Buscar noticias</label>
        <input
          id="q"
          type="search"
          name="q"
          placeholder="Buscar"
          class="w-36 rounded-md border border-[var(--color-linea)] bg-[var(--color-papel)] px-3 py-1.5 text-sm outline-none transition focus:w-48 focus:border-[var(--color-marca)]"
        />
      </form>

      <a
        href="/buscar"
        class="rounded-md p-2 text-[var(--color-tinta-suave)] transition hover:bg-[var(--color-lienzo-alt)] sm:hidden"
        aria-label="Buscar"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </a>

      <button
        type="button"
        id="tema"
        class="rounded-md p-2 text-[var(--color-tinta-suave)] transition hover:bg-[var(--color-lienzo-alt)]"
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Navegación de nichos en móvil: la cabecera no cabe entera. -->
  <nav aria-label="Nichos" class="border-t border-[var(--color-linea)] md:hidden">
    <ul class="contenedor flex gap-1 overflow-x-auto py-2">
      {
        nichos.map((clave) => (
          <li>
            <a
              href={enlaceVertical(clave)}
              aria-current={verticalActiva === clave ? "page" : undefined}
              class:list={[
                "block whitespace-nowrap rounded-md px-3 py-1 font-display text-xs font-bold uppercase tracking-wide",
                verticalActiva === clave
                  ? "text-white"
                  : "bg-[var(--color-lienzo-alt)] text-[var(--color-tinta-suave)]",
              ]}
              style={verticalActiva === clave ? `background:${colorVertical(clave)}` : undefined}
            >
              {nombreVertical(clave)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="contenedor hidden pb-2 text-xs text-[var(--color-tinta-tenue)] md:block">{hoy}</p>
</header>

<script>
  document.getElementById("tema")?.addEventListener("click", () => {
    const oscuro = document.documentElement.classList.toggle("oscuro");
    try {
      localStorage.setItem("tema", oscuro ? "oscuro" : "claro");
    } catch {
      // Almacenamiento bloqueado: el cambio vale solo para esta página.
    }
  });
</script>
