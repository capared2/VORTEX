---
import type { Indice } from "../lib/types";
import Marca from "./Marca.astro";
import { SITIO } from "../lib/sitio";
import { colorVertical, enlaceVertical, fechaLarga, nombreVertical } from "../lib/formato";

interface Props {
  indice: Indice | null;
  verticalActiva?: string;
  /**
   * En móvil, adónde lleva la flecha de volver si no hay de dónde volver
   * (se llegó desde fuera). Sin ella no hay flecha.
   */
  atras?: string;
}

const { indice, verticalActiva, atras } = Astro.props;

// El orden lo marca el propio archivo: el nicho con más fondo va primero.
const verticales = (indice?.verticals ?? []).map((v) => v.vertical);
// Si el índice no llega, la navegación no puede desaparecer.
const nichos = verticales.length ? verticales : ["news", "sports", "gaming", "tech"];
const hoy = fechaLarga(new Date());
---

<!--
  Cabecera de dos pisos, como la de un diario.

  Antes era una sola barra con el logotipo, cuatro pastillas de colores y un
  buscador: la disposición de un panel de aplicación. Un periódico separa dos
  cosas que no compiten: arriba lo de servicio --la fecha, los accesos-- en
  letra pequeña, y debajo la cabecera de verdad con el nombre y las secciones.

  La sección en la que estás se marca con un subrayado y no con una pastilla
  rellena. La pastilla es un control; el subrayado es una portada.

  En el móvil se comporta como la barra de una aplicación: un solo piso con
  la marca, buscar y el menú, que se aparta al bajar leyendo y vuelve en
  cuanto se sube un poco. Las secciones pasan a la barra de pestañas de
  abajo (BarraApp) y lo demás al menú.
-->
<header
  class="barra-superior sticky top-0 z-40 bg-[var(--color-lienzo)]/97 backdrop-blur"
  data-barra
>
  <!--
    El filete de cuatro colores, en el canto de arriba del todo. Es la firma de
    la marca --dice de un vistazo que aquí caben cuatro mundos y no uno-- y ata
    la cabecera con el pie, que lleva el mismo.

    Va arriba y no debajo de la navegación porque ahí se pegaba al subrayado de
    la sección activa y las dos líneas se leían como una sola, sucia.
  -->
  <div class="flex h-[3px]" aria-hidden="true">
    {nichos.map((clave) => <span class="flex-1" style={`background:${colorVertical(clave)}`} />)}
  </div>

  <!-- Piso de servicio. En el móvil la fecha y el tema van en el menú. -->
  <div class="hidden border-b border-[var(--color-linea)] md:block">
    <div
      class="contenedor flex h-8 items-center justify-between text-[0.68rem] text-[var(--color-tinta-tenue)]"
    >
      <p class="uppercase tracking-[0.14em]">{hoy}</p>
      <div class="flex items-center gap-4">
        <a href="/topics" class="hidden hover:text-[var(--color-marca)] sm:inline">All topics</a>
        <a href="/rss.xml" class="hidden hover:text-[var(--color-marca)] sm:inline">RSS</a>
        <button
          id="tema"
          type="button"
          data-cambiar-tema
          class="-mr-1 rounded p-1 transition hover:text-[var(--color-marca)]"
          aria-label="Switch between light and dark"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Cabecera propiamente dicha -->
  <div
    class="contenedor flex h-[3.35rem] items-center gap-2 border-b border-[var(--color-linea)] md:gap-7"
  >
    {
      atras && (
        <a
          href={atras}
          data-atras
          class="boton-app -ml-2 md:hidden"
          aria-label="Back"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 5-7 7 7 7"></path>
          </svg>
        </a>
      )
    }

    <a href="/" class="shrink-0" aria-label={`${SITIO.nombre}, go to the front page`}>
      <Marca />
    </a>

    <nav aria-label="Sections" class="hidden min-w-0 flex-1 self-stretch md:block">
      <ul class="flex h-full items-stretch gap-6">
        {
          nichos.map((clave) => (
            <li class="flex">
              <a
                href={enlaceVertical(clave)}
                aria-current={verticalActiva === clave ? "page" : undefined}
                data-activo={verticalActiva === clave ? "" : undefined}
                class="nicho"
                style={`--acento:${colorVertical(clave)}`}
              >
                {nombreVertical(clave)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form action="/search" method="get" role="search" class="ml-auto hidden shrink-0 sm:block">
      <label for="q" class="sr-only">Search the news</label>
      <input
        id="q"
        type="search"
        name="q"
        placeholder="Search"
        class="w-32 border-b border-[var(--color-linea)] bg-transparent px-1 py-1 text-sm outline-none transition focus:w-44 focus:border-[var(--color-marca)]"
      />
    </form>

    <a
      href="/search"
      class="boton-app ml-auto sm:hidden"
      aria-label="Search"
    >
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
    </a>

    <button
      type="button"
      data-abrir-menu
      class="boton-app -mr-2 md:hidden"
      aria-label="Menu"
      aria-haspopup="dialog"
      aria-controls="menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h10"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Claro u oscuro. Hay un botón en la cabecera de escritorio y un interruptor
  // en el menú del móvil: los dos hacen lo mismo y se mantienen al día.
  const botonesTema = document.querySelectorAll<HTMLElement>("[data-cambiar-tema]");

  function pintarTema() {
    const oscuro = document.documentElement.classList.contains("oscuro");
    botonesTema.forEach((b) => {
      if (b.getAttribute("role") === "switch") b.setAttribute("aria-checked", String(oscuro));
    });
    // El color de la barra del navegador sigue al de la cabecera, como en
    // una aplicación, y no al índigo de la marca.
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", oscuro ? "#12141a" : "#ffffff");
  }

  botonesTema.forEach((boton) =>
    boton.addEventListener("click", () => {
      const oscuro = document.documentElement.classList.toggle("oscuro");
      try {
        localStorage.setItem("tema", oscuro ? "oscuro" : "claro");
      } catch {
        // Almacenamiento bloqueado: el cambio vale solo para esta página.
      }
      pintarTema();
    }),
  );
  pintarTema();

  // En el móvil la barra se aparta al bajar y vuelve al subir: deja la
  // pantalla entera para leer sin obligar a volver arriba para usarla.
  const barra = document.querySelector<HTMLElement>("[data-barra]");
  let ultimaY = scrollY;
  addEventListener(
    "scroll",
    () => {
      if (!barra) return;
      const y = scrollY;
      const paso = y - ultimaY;
      // Los temblores del dedo no cuentan.
      if (Math.abs(paso) < 8) return;
      const escribiendo = barra.querySelector("input:focus") !== null;
      barra.toggleAttribute("data-oculta", paso > 0 && y > 140 && !escribiendo);
      ultimaY = y;
    },
    { passive: true },
  );

  // La flecha de volver hace lo que haría el botón del teléfono si se vino
  // desde dentro del sitio; si se llegó de fuera, lleva a la sección.
  document.querySelector<HTMLAnchorElement>("[data-atras]")?.addEventListener("click", (e) => {
    let interna = false;
    try {
      interna = new URL(document.referrer).origin === location.origin;
    } catch {
      // Sin referente: se llegó de fuera o se abrió en una pestaña nueva.
    }
    if (interna && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  });
</script>
