---
interface Props {
  clase?: string;
}
const { clase = "h-7 w-auto" } = Astro.props;
---

<!--
  Un ancla dentro de un sello redondo.

  La versión anterior era un ancla fina metida en un cuadrado redondeado con
  degradado: eso es el icono de una aplicación, no la marca de un periódico.
  Un sello circular es lo contrario --viene del grabado y del membrete-- y es
  lo que hace que la cabecera se lea como una publicación.

  Todo en `currentColor`: así el mismo dibujo sirve sobre blanco en la
  cabecera y sobre negro en el pie sin tener dos copias que mantener.

  Trazo grueso y pocas formas, porque a 28 px --y a 16 en la pestaña-- lo fino
  se emborrona. Las puntas de uña son lo que hace que se lea como un ancla y
  no como una letra, así que se quedan aunque cuesten dos trazos más.
-->
<svg
  class={clase}
  viewBox="0 0 44 44"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
>
  <circle cx="22" cy="22" r="20.4" stroke-width="2.4" opacity="0.45"></circle>

  <g stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- arganeo -->
    <circle cx="22" cy="10.2" r="3.5"></circle>
    <!-- caña -->
    <path d="M22 13.7V35"></path>
    <!-- cepo: mas ancho que antes, para que el ancla no parezca una letra -->
    <path d="M13.6 17.6h16.8"></path>
    <!-- brazos: la cuchara mas honda, que es lo que la hace reconocible -->
    <path d="M10.4 23.8c0 6.9 5.2 11.2 11.6 11.2s11.6-4.3 11.6-11.2"></path>
    <!-- uñas -->
    <path d="m10.4 23.8-3.6-2.4M33.6 23.8l3.6-2.4"></path>
  </g>
</svg>
